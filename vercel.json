{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "framework": null,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/regles", "destination": "/regles.html" },
    { "source": "/confidentialite", "destination": "/confidentialite.html" },
    { "source": "/strategie", "destination": "/strategie.html" },
    { "source": "/variantes", "destination": "/variantes.html" }
  ]
}
